# Copy to .env and fill in.  .env is gitignored and must never be committed.

DB_NAME=ncaa_basketball
DB_USER=your_postgres_username
# REQUIRED for Docker -- the postgres image will not start without a password.
# Ignored by a local Homebrew Postgres using trust auth.
DB_PASSWORD=changeme

# Local (non-Docker) runs only. Docker Compose overrides these to db:5432,
# because inside a container "localhost" means the container itself.
DB_HOST=localhost
DB_PORT=5432